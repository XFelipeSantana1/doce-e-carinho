# Gere valores exclusivos para este ambiente. Nao reutilize credenciais.
N8N_ENCRYPTION_KEY=gere_uma_chave_aleatoria_longa
WAHA_API_KEY=gere_uma_chave_aleatoria
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=defina_uma_senha_forte
REDIS_PASSWORD=defina_uma_senha_forte
BOT_API_KEY=mesma_chave_configurada_no_backend
BOT_TEST_PHONE=telefone_autorizado_em_formato_internacional
BOT_WEBHOOK_KEY=gere_uma_chave_aleatoria
N8N_PUBLIC_HOST=seu-host-publico

# Provedor ativo: waha (atual) ou meta (Cloud API oficial).
WHATSAPP_PROVIDER=waha
# Preencher somente para ativar meta. Use a versão disponível no painel Meta.
META_API_VERSION=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=

# Gemini opcional: ativar somente com chave de um projeto no plano gratuito.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_PER_MINUTE=5
GEMINI_MAX_PER_DAY=100
